# Копия для локального запуска. На Railway эти значения задаются в Variables сервиса.
# Не коммитьте .env и не отправляйте значения в чаты.
BOT_TOKEN=
CHAT_ID=-100xxxxxxxxxx
# Railway: ссылка на переменную сервиса Postgres, пароль в код не попадает
DATABASE_URL=${{Postgres.DATABASE_URL}}
# Локально (docker compose up -d): DATABASE_URL=postgresql://bot:bot@127.0.0.1:5432/antispam
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Публичный адрес сервиса на Railway, без / на конце
PUBLIC_BASE_URL=https://your-service.up.railway.app
# Длинная случайная строка: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
VERIFY_TIMEOUT_SEC=60
# Сколько неудачных циклов до блокировки
MAX_FAILED_ATTEMPTS=3
# Антиспам первого сообщения новичка (модель Jev через OpenRouter). Без ключа проверка отключена.
OPENROUTER_API_KEY=
# SPAM_MODEL=typesafe/jev-1.13
# Порог блокировки 0..1: чем выше, тем меньше ложных срабатываний
# SPAM_THRESHOLD=0.8

# Таблицы создаются при старте сами (migrations/*.sql). Чтобы отключить: RUN_MIGRATIONS=0
# RUN_MIGRATIONS=1
